# Redis (Upstash) — from the Vercel Marketplace "Redis" integration,
# or an Upstash database created directly at upstash.com.
#
# If left unset, the app falls back to an in-memory store that works
# fine for local development but resets whenever the dev server restarts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel's marketplace integration may instead inject these names —
# the app reads either pair, so only fill in the one you have.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
